# --- Database (PostgreSQL: Supabase, managed, or self-hosted) ---
# Leave empty to use the in-memory database (demo only, lost on restart)
DATABASE_URL=
# URD_PG_SSL=disable   # for a local Postgres without TLS

# --- Image storage: local | supabase ---
URD_STORAGE=local
URD_STORAGE_DIR=./data
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=snapshots

# --- Server ---
PORT=8787
URD_CORS_ORIGIN=*
# URD_DIFF_THRESHOLD=0.1
# URD_REGRESSION_PERCENT=0.2
